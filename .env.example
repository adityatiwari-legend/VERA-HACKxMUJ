# Database Configuration (PostgreSQL with pg driver)
# When running via Docker, fundtrail-db runs on port 5432 internally, and 5433 on the host:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/fundtrail

# Authentication (JWT Secret for HTTP-only session cookies, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug SQL Queries (optional: set to true to log direct SQL queries)
DEBUG_SQL=false
