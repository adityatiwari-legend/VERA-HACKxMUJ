# Database Configuration (PostgreSQL with native pg driver)
# When running via Docker, vera-db runs on port 5432 internally, and 5433 on the host:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/vera

# Authentication (JWT Secret for HTTP-only session cookies, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Debug SQL Queries (optional: set to true to log direct SQL queries)
DEBUG_SQL=false

# Evidence Storage Configuration
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=50

# Phase 4 & 5 — Blockchain Configuration (Ethereum Sepolia / Holesky / Hardhat)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016
NEXT_PUBLIC_CHAIN_ID=31337
BLOCKCHAIN_NETWORK=hardhat
